{
  "manifest_version": 3,
  "name": "Gemini Grammar & Rephrase Helper",
  "version": "1.2.2",
  "description": "Auto-check grammar & rephrase with Gemini AI. Real-time checks as you type + smart right-click suggestions.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.freemius.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    },
    "default_title": "Gemini Grammar & Rephrase Helper - Open Settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "fix-grammar-rephrase": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "Fix grammar and rephrase selected text"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gemini-helper@your-domain.com",
      "strict_min_version": "109.0"
    }
  }
}
